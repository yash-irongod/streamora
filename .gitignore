# ═══════════════════════════════════════════════════════════════
# Streamora — .gitignore
# ═══════════════════════════════════════════════════════════════

# ─── Dependencies ──────────────────────────────────────────────
node_modules/

# ─── Build Output ──────────────────────────────────────────────
dist/
dist-ssr/
build/

# ─── Environment Variables (SENSITIVE — never commit) ──────────
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── OS Files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── Editor / IDE ──────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# ─── Testing ───────────────────────────────────────────────────
coverage/
*.lcov

# ─── Misc ──────────────────────────────────────────────────────
*.local
*.tsbuildinfo
.eslintcache
.cache/
.turbo/